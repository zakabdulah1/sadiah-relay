{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sadiah-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_TUNNELS", "class_name": "RelayTunnel" }
    ]
